# Copy to .env.local and fill in. Public web app configuration only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Required for any non-emulator use: the callables enforce App Check.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
# Which provider the site key belongs to: enterprise (default) or v3.
NEXT_PUBLIC_APP_CHECK_PROVIDER=enterprise
# Optional App Check debug token for development against a live project.
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=
# Must match REGION in functions/src/runtime-region.ts.
NEXT_PUBLIC_FUNCTIONS_REGION=africa-south1
NEXT_PUBLIC_RESTAURANT_ID=bukhara
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Set to true to route the client at the local Firebase emulators.
NEXT_PUBLIC_USE_EMULATORS=false
# Server-only; never expose private credentials as NEXT_PUBLIC_ variables.
